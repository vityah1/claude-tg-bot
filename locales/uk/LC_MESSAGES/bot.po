msgid_plural "🗑 The {count} messages were discarded — they went to no session."
msgstr[0] "🗑 {count} повідомлення відкинуто — воно не пішло в жодну сесію."
msgstr[1] "🗑 {count} повідомлення відкинуто — вони не пішли в жодну сесію."
msgstr[2] "🗑 {count} повідомлень відкинуто — вони не пішли в жодну сесію."

