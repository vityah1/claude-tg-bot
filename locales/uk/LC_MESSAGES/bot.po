msgstr "у ній досі працюють фонові завдання ({what}), і /exit їх зупинить"

#: ccbot/bot.py:2167
msgid "background tasks are still running in it, and /exit would stop them"
msgstr "у ній ще працюють фонові задачі, і /exit їх зупинить"

#: ccbot/bot.py:2178 ccbot/bot.py:2263
msgid "it is working right now"
msgstr "вона зараз працює"

#: ccbot/bot.py:2187
msgid "a restart of it is already under way"
msgstr "її перезапуск уже триває"

#: ccbot/bot.py:2206 ccbot/bot.py:2499
msgid "it is working or waiting for an answer"
msgstr "вона працює або чекає на відповідь"

#: ccbot/bot.py:2228
msgid "its tmux window is gone"
msgstr "його вікно tmux зникло"

#: ccbot/bot.py:2253 ccbot/bot.py:2265 ccbot/bot.py:2495
msgid "it is waiting for an answer"
msgstr "вона чекає на відповідь"

#: ccbot/bot.py:2273
msgid ""
"the claude CLI is not on disk this second — it is updating itself; try again"
" in a minute"
msgstr "саме зараз claude немає на диску — він оновлює сам себе; спробуй за хвилину"

#: ccbot/bot.py:2278 ccbot/bot.py:2893
msgid "the session host is not answering"
msgstr "хост сесій не відповідає"

#: ccbot/bot.py:2299
#, python-brace-format
