# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Bot token from @BotFather
TG_BOT_TOKEN=

# Telegram user IDs allowed to use this bot, comma-separated.
# Get yours from @userinfobot. Anyone else is ignored silently.
TG_ALLOWED_USER_IDS=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Project roots offered when starting a session, comma-separated.
# Leave empty to manage them from the bot (/dirs) or to let the bot discover
# them from your Claude session history. Setting this here overrides both.
# CCBOT_DIRS=/path/to/project-a,/path/to/project-b

# Seconds between terminal/transcript polls.
# CCBOT_POLL_INTERVAL=1.5

# INFO (default) or DEBUG — DEBUG also records every tmux command.
# CCBOT_LOG_LEVEL=INFO

# Path to the claude CLI. Usually detected automatically; set it if the bot
# reports that it cannot find it (systemd units do not read your shell profile).
# CCBOT_CLAUDE_BIN=/path/to/claude

# The interface language has no variable here on purpose: it is a choice made
# at runtime, not a machine fact. The bot follows your Telegram profile until
# /lang says otherwise, and stores that in ~/.config/ccbot/config.json.

# Timezone for rate-limit reset times ("resets tomorrow 09:00").
# Unset means the host's own clock. That is right for a laptop, but WSL images
# and rented servers are almost always on Etc/UTC, in which case the times are
# wrong by whole hours until this is set. ./install.sh asks about it.
# CCBOT_TZ=Europe/Kyiv
