#!/usr/bin/env bash
# Refuse a commit that would not start. Bypass in an emergency: git commit -n
#
# The checks run against the working tree, not the index, so a partially
# staged change is checked as a whole; that is deliberate — the bot is run
# from the tree, and a tree that fails is a bot that will not come back up.
cd "$(git rev-parse --show-toplevel)" || exit 1

if ! git diff --quiet -- '*.py'; then
    echo "ℹ️  Unstaged .py changes in the tree — checking the tree as a whole."
fi

exec bin/check.sh
